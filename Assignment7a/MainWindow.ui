<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>900</width><height>820</height></rect>
  </property>
  <property name="minimumSize">
   <size><width>860</width><height>780</height></size>
  </property>
  <property name="windowTitle">
   <string>Rock Paper Scissors — Fantastic 4</string>
  </property>

  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string>QWidget#centralwidget { background-color: #2e4a3e; }
QGroupBox {
    font-weight: bold; font-size: 13px;
    border: 1px solid #a8d5b5; border-radius: 8px;
    margin-top: 8px; padding-top: 8px;
    color: #ffffff; background-color: #3a6b52;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #d4edda; }
QLabel { color: #eaf5ec; }
QLabel#titleLabel { font-size: 24px; font-weight: bold; color: #ffffff; }
QLabel#teamLabel { font-size: 12px; color: #95d5b2; font-style: italic; letter-spacing: 1px; }
QLabel#statusLabel { font-size: 12px; color: #c8e6c9; font-style: italic; }
QLabel#vsLabel { font-size: 22px; font-weight: bold; color: #ffffff; }
QLabel#humanHandLabel, QLabel#computerHandLabel {
    background-color: #ffffff; border-radius: 10px; border: 3px solid #a8d5b5;
}
QLabel#humanNameLabel, QLabel#computerNameLabel { font-size: 12px; color: #d4edda; font-weight: bold; }
QLabel#winnerLabel { font-size: 16px; font-weight: bold; }
QPushButton#rockButton, QPushButton#paperButton, QPushButton#scissorsButton {
    font-size: 13px; font-weight: bold; min-height: 60px;
    border-radius: 10px; border: 2px solid #6aab82;
    background-color: #3a6b52; color: #aaaaaa;
}
QPushButton#rockButton:enabled, QPushButton#paperButton:enabled, QPushButton#scissorsButton:enabled {
    background-color: #4e8c6a; border-color: #a8d5b5; color: #ffffff;
}
QPushButton#rockButton:hover, QPushButton#paperButton:hover, QPushButton#scissorsButton:hover {
    background-color: #5fa37c; border-color: #ffffff;
}
QPushButton#rockButton:disabled, QPushButton#paperButton:disabled, QPushButton#scissorsButton:disabled {
    color: #6aab82; border-color: #3a6b52; background-color: #2e4a3e;
}
QPushButton#startButton {
    font-size: 13px; font-weight: bold; min-height: 34px;
    background-color: #5cb85c; color: #ffffff;
    border-radius: 8px; border: none; padding: 4px 24px;
}
QPushButton#startButton:hover { background-color: #4cae4c; }
QPushButton#startButton:disabled { background-color: #6aab82; color: #c8e6c9; }
QPushButton#resetLearningButton {
    font-size: 12px; min-height: 34px;
    background-color: #7a3a3a; color: #f5c6c6;
    border-radius: 8px; border: none; padding: 4px 14px;
}
QPushButton#resetLearningButton:hover { background-color: #a04444; }
QPushButton#resetLearningButton:disabled { background-color: #4a2a2a; color: #7a5a5a; }
QPushButton#viewDataButton {
    font-size: 12px; min-height: 34px;
    background-color: #2a4a6a; color: #c6ddf5;
    border-radius: 8px; border: none; padding: 4px 14px;
}
QPushButton#viewDataButton:hover { background-color: #3a6a9a; }
QComboBox, QSpinBox {
    background-color: #4e8c6a; color: #ffffff;
    border: 1px solid #a8d5b5; border-radius: 4px; padding: 2px 6px;
}
QComboBox QAbstractItemView { background-color: #4e8c6a; color: #ffffff; }
QLabel#humanScoreLabel, QLabel#computerScoreLabel, QLabel#tiesLabel {
    font-size: 24px; font-weight: bold; color: #ffffff;
}
QLabel#humanScoreTitleLbl, QLabel#computerScoreTitleLbl, QLabel#tiesTitleLbl {
    font-size: 12px; color: #c8e6c9;
}
QScrollArea { border: none; background-color: transparent; }
QWidget#historyContainer { background-color: transparent; }
QPushButton#hostButton {
    font-size: 12px; min-height: 30px;
    background-color: #2a5a8a; color: #d0e8ff;
    border-radius: 8px; border: none; padding: 4px 14px;
}
QPushButton#hostButton:hover { background-color: #3a7ab0; }
QPushButton#hostButton:disabled { background-color: #1a3a5a; color: #6a8aaa; }
QPushButton#joinButton {
    font-size: 12px; min-height: 30px;
    background-color: #5a3a8a; color: #e0d0ff;
    border-radius: 8px; border: none; padding: 4px 14px;
}
QPushButton#joinButton:hover { background-color: #7a4ab0; }
QPushButton#joinButton:disabled { background-color: #3a1a5a; color: #8a6aaa; }
QPushButton#disconnectNetButton {
    font-size: 12px; min-height: 30px;
    background-color: #7a3a3a; color: #f5c6c6;
    border-radius: 8px; border: none; padding: 4px 14px;
}
QPushButton#disconnectNetButton:hover { background-color: #a04444; }
QLabel#netStatusLabel { font-size: 12px; color: #b0d8ff; font-style: italic; }
QLineEdit {
    background-color: #4e8c6a; color: #ffffff;
    border: 1px solid #a8d5b5; border-radius: 4px; padding: 2px 6px;
}
</string>
   </property>

   <layout class="QHBoxLayout" name="rootLayout">
    <property name="spacing"><number>10</number></property>
    <property name="leftMargin"><number>12</number></property>
    <property name="topMargin"><number>12</number></property>
    <property name="rightMargin"><number>12</number></property>
    <property name="bottomMargin"><number>12</number></property>

    <!-- LEFT: game panel -->
    <item>
     <layout class="QVBoxLayout" name="leftPanel">
      <property name="spacing"><number>10</number></property>

      <item>
       <widget class="QLabel" name="titleLabel">
        <property name="text"><string>Rock  ·  Paper  ·  Scissors</string></property>
        <property name="alignment"><set>Qt::AlignCenter</set></property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="teamLabel">
        <property name="text"><string>by  Fantastic 4</string></property>
        <property name="alignment"><set>Qt::AlignCenter</set></property>
       </widget>
      </item>

      <item>
       <widget class="QGroupBox" name="setupGroup">
        <property name="title"><string>Game Setup</string></property>
        <layout class="QVBoxLayout" name="setupVLayout">
         <property name="spacing"><number>8</number></property>
         <item>
          <layout class="QHBoxLayout" name="setupRow1">
           <item>
            <widget class="QLabel" name="algoLabel">
             <property name="text"><string>Algorithm:</string></property>
            </widget>
           </item>
           <item>
            <widget class="QComboBox" name="algorithmCombo">
             <property name="minimumWidth"><number>110</number></property>
             <item><property name="text"><string>Random</string></property></item>
             <item><property name="text"><string>Smart</string></property></item>
            </widget>
           </item>
           <item>
            <spacer name="setupSp1">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>20</width><height>0</height></size></property>
            </spacer>
           </item>
           <item>
            <widget class="QLabel" name="roundsLabel">
             <property name="text"><string>Rounds:</string></property>
            </widget>
           </item>
           <item>
            <widget class="QSpinBox" name="roundsSpinBox">
             <property name="minimum"><number>1</number></property>
             <property name="maximum"><number>100</number></property>
             <property name="value"><number>10</number></property>
             <property name="minimumWidth"><number>60</number></property>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout" name="setupRow2">
           <item>
            <spacer name="setupSp2">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>40</width><height>0</height></size></property>
            </spacer>
           </item>
           <item>
            <widget class="QPushButton" name="startButton">
             <property name="text"><string>Start Game</string></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="resetLearningButton">
             <property name="text"><string>Reset Learning</string></property>
             <property name="toolTip"><string>Delete saved frequency data so the Smart algorithm starts fresh</string></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="viewDataButton">
             <property name="text"><string>View Data</string></property>
             <property name="toolTip"><string>Show current frequency learning data</string></property>
            </widget>
           </item>
           <item>
            <spacer name="setupSp3">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>40</width><height>0</height></size></property>
            </spacer>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </item>

      <item>
       <widget class="QGroupBox" name="networkGroup">
        <property name="title"><string>Network Multiplayer</string></property>
        <layout class="QVBoxLayout" name="netVLayout">
         <property name="spacing"><number>6</number></property>
         <item>
          <layout class="QHBoxLayout" name="netMainRow">
           <property name="spacing"><number>16</number></property>
           <item>
            <layout class="QVBoxLayout" name="hostCol">
             <item>
              <widget class="QLabel" name="hostTitleLbl">
               <property name="text"><string>Host a Game</string></property>
               <property name="font"><font><bold>true</bold></font></property>
              </widget>
             </item>
             <item>
              <layout class="QHBoxLayout" name="hostRow1">
               <item>
                <widget class="QLabel" name="hostIpTitleLbl">
                 <property name="text"><string>Your IP:</string></property>
                </widget>
               </item>
               <item>
                <widget class="QLabel" name="hostIpLabel">
                 <property name="text"><string>—</string></property>
                 <property name="font"><font><bold>true</bold></font></property>
                </widget>
               </item>
               <item>
                <widget class="QLabel" name="hostPortTitleLbl">
                 <property name="text"><string>Port:</string></property>
                </widget>
               </item>
               <item>
                <widget class="QSpinBox" name="hostPortSpinBox">
                 <property name="minimum"><number>1024</number></property>
                 <property name="maximum"><number>65535</number></property>
                 <property name="value"><number>12345</number></property>
                 <property name="minimumWidth"><number>70</number></property>
                </widget>
               </item>
              </layout>
             </item>
             <item>
              <layout class="QHBoxLayout" name="hostRow2">
               <item>
                <widget class="QLabel" name="netModeLabel">
                 <property name="text"><string>Mode:</string></property>
                </widget>
               </item>
               <item>
                <widget class="QComboBox" name="netModeCombo">
                 <property name="minimumWidth"><number>140</number></property>
                 <item><property name="text"><string>vs Computer (1 player)</string></property></item>
                 <item><property name="text"><string>vs Player (2 players)</string></property></item>
                </widget>
               </item>
               <item>
                <widget class="QLabel" name="netRoundsLabel">
                 <property name="text"><string>Rounds:</string></property>
                </widget>
               </item>
               <item>
                <widget class="QSpinBox" name="netRoundsSpinBox">
                 <property name="minimum"><number>1</number></property>
                 <property name="maximum"><number>100</number></property>
                 <property name="value"><number>10</number></property>
                 <property name="minimumWidth"><number>60</number></property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="hostButton">
                 <property name="text"><string>Host Game</string></property>
                </widget>
               </item>
              </layout>
             </item>
            </layout>
           </item>
           <item>
            <widget class="QFrame" name="netDivider">
             <property name="frameShape"><enum>QFrame::VLine</enum></property>
             <property name="frameShadow"><enum>QFrame::Sunken</enum></property>
            </widget>
           </item>
           <item>
            <layout class="QVBoxLayout" name="joinCol">
             <item>
              <widget class="QLabel" name="joinTitleLbl">
               <property name="text"><string>Join a Game</string></property>
               <property name="font"><font><bold>true</bold></font></property>
              </widget>
             </item>
             <item>
              <layout class="QHBoxLayout" name="joinRow1">
               <item>
                <widget class="QLabel" name="joinIpTitleLbl">
                 <property name="text"><string>Server IP:</string></property>
                </widget>
               </item>
               <item>
                <widget class="QLineEdit" name="joinIpEdit">
                 <property name="text"><string>127.0.0.1</string></property>
                 <property name="minimumWidth"><number>110</number></property>
                </widget>
               </item>
               <item>
                <widget class="QLabel" name="joinPortTitleLbl">
                 <property name="text"><string>Port:</string></property>
                </widget>
               </item>
               <item>
                <widget class="QSpinBox" name="joinPortSpinBox">
                 <property name="minimum"><number>1024</number></property>
                 <property name="maximum"><number>65535</number></property>
                 <property name="value"><number>12345</number></property>
                 <property name="minimumWidth"><number>70</number></property>
                </widget>
               </item>
              </layout>
             </item>
             <item>
              <layout class="QHBoxLayout" name="joinRow2">
               <item>
                <widget class="QLabel" name="joinNameTitleLbl">
                 <property name="text"><string>Your name:</string></property>
                </widget>
               </item>
               <item>
                <widget class="QLineEdit" name="joinNameEdit">
                 <property name="text"><string>Player</string></property>
                 <property name="minimumWidth"><number>100</number></property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="joinButton">
                 <property name="text"><string>Join Game</string></property>
                </widget>
               </item>
               <item>
                <widget class="QPushButton" name="disconnectNetButton">
                 <property name="text"><string>Disconnect</string></property>
                 <property name="enabled"><bool>false</bool></property>
                </widget>
               </item>
              </layout>
             </item>
            </layout>
           </item>
          </layout>
         </item>
         <item>
          <widget class="QLabel" name="netStatusLabel">
           <property name="text"><string>Host a game or join one above to play over the network.</string></property>
           <property name="alignment"><set>Qt::AlignCenter</set></property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>

      <item>
       <widget class="QGroupBox" name="roundGroup">
        <property name="title"><string>Round</string></property>
        <layout class="QVBoxLayout" name="roundVLayout">
         <property name="spacing"><number>6</number></property>
         <item>
          <layout class="QHBoxLayout" name="handsRow">
           <item>
            <layout class="QVBoxLayout" name="humanCol">
             <item>
              <widget class="QLabel" name="humanNameLabel">
               <property name="text"><string>You</string></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="humanHandLabel">
               <property name="text"><string></string></property>
               <property name="minimumSize"><size><width>130</width><height>130</height></size></property>
               <property name="maximumSize"><size><width>130</width><height>130</height></size></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
              </widget>
             </item>
            </layout>
           </item>
           <item>
            <spacer name="handsSp1">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>10</width><height>0</height></size></property>
            </spacer>
           </item>
           <item>
            <widget class="QLabel" name="vsLabel">
             <property name="text"><string>VS</string></property>
             <property name="alignment"><set>Qt::AlignCenter</set></property>
            </widget>
           </item>
           <item>
            <spacer name="handsSp2">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>10</width><height>0</height></size></property>
            </spacer>
           </item>
           <item>
            <layout class="QVBoxLayout" name="computerCol">
             <item>
              <widget class="QLabel" name="computerNameLabel">
               <property name="text"><string>Computer</string></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
              </widget>
             </item>
             <item>
              <widget class="QLabel" name="computerHandLabel">
               <property name="text"><string></string></property>
               <property name="minimumSize"><size><width>130</width><height>130</height></size></property>
               <property name="maximumSize"><size><width>130</width><height>130</height></size></property>
               <property name="alignment"><set>Qt::AlignCenter</set></property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </item>
         <item>
          <widget class="QLabel" name="winnerLabel">
           <property name="text"><string>—</string></property>
           <property name="alignment"><set>Qt::AlignCenter</set></property>
           <property name="font"><font><bold>true</bold></font></property>
          </widget>
         </item>
         <item>
          <layout class="QGridLayout" name="roundDetailsGrid">
           <property name="verticalSpacing"><number>4</number></property>
           <property name="horizontalSpacing"><number>12</number></property>
           <item row="0" column="0">
            <widget class="QLabel" name="roundTitleLbl">
             <property name="text"><string>Round:</string></property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QLabel" name="roundLabel">
             <property name="text"><string>—</string></property>
             <property name="font"><font><bold>true</bold></font></property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="predictionTitleLbl">
             <property name="text"><string>Computer predicted:</string></property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QLabel" name="predictionLabel">
             <property name="text"><string>—</string></property>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </item>

      <item>
       <widget class="QLabel" name="statusLabel">
        <property name="text"><string>Click "Start Game" to begin.</string></property>
        <property name="alignment"><set>Qt::AlignCenter</set></property>
       </widget>
      </item>

      <item>
       <layout class="QHBoxLayout" name="choiceLayout">
        <property name="spacing"><number>10</number></property>
        <item>
         <widget class="QPushButton" name="rockButton">
          <property name="text"><string>Rock</string></property>
          <property name="enabled"><bool>false</bool></property>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="paperButton">
